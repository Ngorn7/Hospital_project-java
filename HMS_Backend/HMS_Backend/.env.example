# Copy to .env (gitignored) and replace every placeholder. Never commit a populated .env.
# application.properties imports this file automatically when it sits in the project root.
DB_URL=jdbc:postgresql://localhost:5432/HMS_DB
DB_USERNAME=postgres
DB_PASSWORD=Kimngon2

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-32-plus-characters

# Used once by POST /api/v1/auth/initial-admin to create the first administrator.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
